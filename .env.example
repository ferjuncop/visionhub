# Copiar a .env y rellenar con valores reales. Nunca subir .env al repositorio.

# Postgres del contenedor vh-postgres (ver infrastructure/docker-compose.yml)
POSTGRES_USER=visionhub
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=visionhub
POSTGRES_PORT=55434

DATABASE_URL="postgresql://visionhub:cambia-esto@127.0.0.1:55434/visionhub"

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-tambien
